<!-- prettier-ignore -->
<% layout("/layouts/boilerplate") %>


<div id="filters">
  <div class="filters-icons">
   <a href="/listings?category=trending" class="filter text-decoration-none text-dark">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
   </a>

   <a href="/listings?category=rooms" class="filter text-decoration-none text-dark">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
   </a>
  

  <a href="/listings?category=iconic" class="filter text-decoration-none text-dark">
    <div><i class="fa-solid fa-mountain-city"></i></div>
    <p>Iconic Cities</p>
  </a>

  <a href="/listings?category=mountains" class="filter text-decoration-none text-dark">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Mountains</p>
  </a>

  <a href="/listings?category=castles" class="filter text-decoration-none text-dark">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p>Castles</p>
  </a>

  <a href="/listings?category=pools" class="filter text-decoration-none text-dark">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing Pools</p>
  </a>

  <a href="/listings?category=camping" class="filter text-decoration-none text-dark">
    <div><i class="fa-solid fa-cow"></i></div>
    <p>Camping</p>
  </a>

  <a href="/listings?category=farms" class="filter text-decoration-none text-dark">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Farms</p>
  </a>

  <a href="/listings?category=arctic" class="filter text-decoration-none text-dark">
    <div><i class="fa-solid fa-snowflake"></i></div>
    <p>Arctic</p>
  </a>

  <a href="/listings?category=domes" class="filter text-decoration-none text-dark">
    <div><i class="fa-solid fa-igloo"></i></div>
    <p>Domes</p>
  </a>

  <a href="/listings?category=boats" class="filter text-decoration-none text-dark">
    <div><i class="fa-solid fa-ship"></i></div>
    <p>Boats</p>
  </a>
 </div>
  <!-- tax toggle untouched -->

  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
     <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
     <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
    </div>
  </div>

</div>

<% if(category) { %>
  <h4 class="mt-3">
    Showing results for "<%= category %>"
  </h4>
<% } %>


<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
  <% for(let listing of allListings) { %>

    <div class="col mb-4">
      <a href="/listings/<%= listing._id %>" class="listing-link text-decoration-none text-dark">
        <div class="card listing-card h-100">
          <img
            src="<%= listing.image.url %>"
            class="card-img-top"
            alt="listing_image"
            style="height: 20rem; object-fit: cover"
          />
          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %></b><br />
              ₹ <%= listing.price.toLocaleString("en-IN") %> / night
              <i class="tax-info"> +18% GST</i>
            </p>
          </div>
        </div>
      </a>
    </div>

  <% } %>
</div>


<script>
  const taxSwitch = document.getElementById("switchCheckDefault");

  if (taxSwitch) {
    taxSwitch.addEventListener("change", () => {
      const taxInfo = document.getElementsByClassName("tax-info");

      for (let info of taxInfo) {
        info.style.display = taxSwitch.checked ? "inline" : "none";
      }
    });
  }


</script>

